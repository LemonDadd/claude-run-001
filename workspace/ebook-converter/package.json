{
  "name": "ebook-converter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "手机端电子书格式转换器 (txt / docx / epub / pdf)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "build:gbk": "node scripts/build-gbk-table.mjs",
    "test": "vitest run",
    "smoke:matrix": "tsx scripts/matrix-smoke.ts",
    "smoke:browser": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.10.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "iconv-lite": "^0.6.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
